# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/

# Datasets (downloaded, never committed)
data/*
!data/.gitkeep

# Training outputs. Per-run metrics, configs, histories, logs and test predictions are committed;
# checkpoints and scratch folders stay local.
outputs/*
!outputs/.gitkeep
!outputs/baseline/
!outputs/logs/
!outputs/tuning/
!outputs/tuned/
!outputs/small_cnn_scratch/
!outputs/resnet50_finetune/
!outputs/resnet50_frozen/
!outputs/resnet50_random/
!outputs/convnext_tiny_finetune/
!outputs/convnext_tiny_frozen/
outputs/logs/queue_*.txt
outputs/logs/remaining_runs.txt
*.pt
*.pth
*.ckpt
*.safetensors

# Final figures and summary tables ARE committed: results/
# (per-run raw files stay in outputs/)

# Course material
ML-Assignment-Topics-EN.pdf

# Private documents (kept locally only)
docs/

# LaTeX build files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc

# Editor / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Training logs in outputs/ are committed (after the *.log rule above)
!outputs/**/*.log
